---
/**
 * Scene 1: The Doorstep.
 * Mary's own hero animation (components/hero/HeroScene.astro, from the
 * Animation folder, used unchanged): she takes a tray of brownies and oat
 * revel bars out of her pink oven on a 10-second loop. It is pure CSS inside
 * the SVG, honours reduced motion itself, and pauses while off screen
 * (scripts/motion/scenes/doorstep.ts).
 */
import Scene from '../ui/Scene.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import HeroScene from '../hero/HeroScene.astro';
import { copy } from '../../data/copy.en';
import crumbs from '../../assets/brand/elements/crumbs.svg';

const t = copy.doorstep;
---

<Scene id="doorstep" name="doorstep" tone="pink" pattern="pink" drip labelledby="doorstep-hello" class="doorstep">
  <div class="doorstep__crumbs" data-crumbs style={`--crumb: url(${crumbs.src})`} aria-hidden="true"></div>

  <div class="doorstep__inner">
    <div class="doorstep__words">
      <p class="doorstep__tag label">{t.tag}</p>
      <h1 id="doorstep-hello" class="doorstep__hello" data-hello>{t.hello}</h1>
      <p class="doorstep__line short-line">{t.line}</p>
    </div>

    <div class="doorstep__stage" data-stage>
      <HeroScene class="doorstep__scene" />
      <p class="mary-says" data-mary-says>
        <span class="mary-says__title">{t.ready.title}</span>
        <span class="mary-says__line">{t.ready.line}</span>
      </p>
    </div>
    <div class="doorstep__order">
      <WhatsAppButton label={copy.cta.saveBox} variant="paper" />
      <ul class="doorstep__facts">
        {t.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>
  </div>
</Scene>

<style>
  :global(.doorstep) {
    padding-block: clamp(5.5rem, 4.5rem + 3vw, 7rem) clamp(3.5rem, 2rem + 5vw, 6rem);
    overflow-x: clip;
  }

  .doorstep__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-areas: 'words' 'stage' 'order';
    justify-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    max-inline-size: 72rem;
    min-block-size: min(100svh - 6rem, 56rem);
    margin-inline: auto;
    align-content: center;
    text-align: center;
  }

  .doorstep__words {
    grid-area: words;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    inline-size: 100%;
    container-type: inline-size; /* the headline sizes itself to this column */
  }
  .doorstep__stage { grid-area: stage; }
  .doorstep__order { grid-area: order; display: grid; justify-items: center; gap: 1rem; }

  .doorstep__tag {
    padding: 0.4rem 0.9rem;
    border-radius: var(--radius-pill);
    background: var(--color-cream);
    border: 2px solid var(--color-cocoa);
  }

  .doorstep__hello {
    /* 'welcome!' is the longest word: ~4.6em wide, so 19% of the column keeps it whole. */
    font-size: clamp(3rem, 19cqi, 7.5rem);
    color: var(--color-cocoa);
    line-height: 0.95;
  }
  .doorstep__hello :global(.word) { white-space: nowrap; }

  .doorstep__line {
    font-size: var(--text-lead);
    max-inline-size: 22ch;
  }

  .doorstep__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
    font-weight: 800;
    font-size: var(--text-caption);
  }
  .doorstep__facts li {
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: var(--color-blush);
    border: 2px solid var(--color-cocoa);
  }

  /* ---------- The stage: Mary's animated kitchen ---------- */
  .doorstep__stage {
    position: relative;
    inline-size: min(100%, 34rem);
    padding-block-start: 3.5rem; /* room for Mary's speech bubble */
  }

  /* Mary's speech bubble: appears once the tray is out (doorstep.ts). Without
     motion or JS it is simply there. Its tail points down at Mary. */
  .mary-says {
    position: absolute;
    z-index: 2;
    inset-block-start: 0;
    inset-inline-end: 4%;
    display: grid;
    gap: 0.1rem;
    max-inline-size: min(17rem, 62%);
    padding: 0.7rem 1rem 0.75rem;
    border-radius: var(--radius-lg);
    background: var(--color-cream);
    border: var(--border-line) solid var(--color-cocoa);
    box-shadow: 0 4px 0 var(--color-cocoa);
    text-align: center;
    transform-origin: 70% 100%;
  }
  .mary-says::after {
    content: '';
    position: absolute;
    inset-block-start: 100%;
    inset-inline-end: 24%;
    inline-size: 1.1rem;
    block-size: 1.1rem;
    margin-block-start: -0.55rem;
    background: var(--color-cream);
    border-inline-end: var(--border-line) solid var(--color-cocoa);
    border-block-end: var(--border-line) solid var(--color-cocoa);
    transform: rotate(45deg);
  }
  .mary-says__title {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-style: italic;
    font-weight: 700;
    font-size: 1.5rem; /* rose is for 24px+ type only */
    line-height: 1.1;
    color: var(--color-rose);
  }
  .mary-says__line { font-weight: 800; font-size: var(--text-caption); line-height: 1.35; }
  :global(html.motion-pending) .mary-says { opacity: 0; }

  /* Pointer crumbs (desktop only, filled by doorstep.ts). */
  .doorstep__crumbs {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .doorstep__crumbs :global(.crumb) {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    inline-size: 18px;
    block-size: 18px;
    background: var(--crumb) center / contain no-repeat;
    opacity: 0;
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 768px) {
    .doorstep__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'words stage' 'order stage';
      justify-items: start;
      align-items: center;
      text-align: start;
      column-gap: clamp(2rem, 1rem + 4vw, 5rem);
    }
    .doorstep__words { justify-items: start; align-self: end; }
    .doorstep__order { justify-items: start; align-self: start; }
    .doorstep__facts { justify-content: flex-start; }
    .doorstep__stage { justify-self: end; inline-size: min(50vw, 42rem); }
  }

  /* Calm patches in the sprinkles behind the words (readability). */
  :global(.doorstep) {
    --pattern-mask: linear-gradient(to bottom, rgb(0 0 0 / 0.14) 0 40%, black 52% 70%, rgb(0 0 0 / 0.14) 82% 100%);
  }
  @media (min-width: 768px) {
    :global(.doorstep) { --pattern-mask: linear-gradient(to right, rgb(0 0 0 / 0.14) 0 44%, black 58%); }
  }
</style>