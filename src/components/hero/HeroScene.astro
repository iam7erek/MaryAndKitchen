---
// Mary And Kitchen hero scene: Mary + her pink oven, 10s loop. Usage: <HeroScene class="w-full max-w-2xl" />
const { class: cls = "" } = Astro.props;
---
<div class={`mak-hero-scene ${cls}`} role="img" aria-label="Mary takes a tray of fresh brownies and oat revel bars out of her pink oven">
<svg xmlns="http://www.w3.org/2000/svg" viewBox="20 0 740 500" aria-hidden="true"><title>Mary takes a tray of fresh brownies and oat revel bars out of her pink oven</title><style>
.ov-tray{transform:translate(210px,342px) scale(1.15)}
.ov-mittL{transform:translate(501px,361px)}.ov-mittR{transform:translate(631px,361px)}
.ov-oven,.ov-door,.ov-hand,.ov-spark,.ov-ding,.ov-h,.ov-knob,.ov-mary{transform-box:fill-box}
.ov-oven,.ov-door,.ov-mary{transform-origin:50% 100%}
.ov-hand,.ov-spark,.ov-ding,.ov-h,.ov-knob{transform-origin:50% 50%}

.ov-oven{animation:ov-hop 10s ease-in-out infinite}
.ov-hand{animation:ov-timer 10s linear infinite}
.ov-glow{animation:ov-glow 1.6s ease-in-out infinite alternate}
.ov-coil{animation:ov-coil 1.2s linear infinite}
.ov-steam{animation:ov-steam 3s ease-out infinite}.ov-steam2{animation-delay:1.5s}
.ov-knob1{animation:ov-wiggle 10s ease-in-out infinite}.ov-knob4{animation:ov-wiggle 10s ease-in-out infinite .15s}
.ov-spark{animation:ov-spark 10s ease-out infinite}
.ov-ding{animation:ov-ding 10s ease-out infinite}
.ov-door{animation:ov-door 10s ease-in-out infinite}
.ov-traybake{animation:ov-inoven 10s linear infinite}
.ov-tray{animation:ov-tray 10s ease-in-out infinite,ov-trayvis 10s linear infinite}
.ov-mittL{animation:ov-mittL 10s ease-in-out infinite}
.ov-mittR{animation:ov-mittR 10s ease-in-out infinite}
.ov-mary{animation:ov-mary 10s ease-in-out infinite}
.ov-wink{animation:ov-wink 10s linear infinite}
.ov-tsteam{animation:ov-tsteam 10s ease-out infinite}.ov-tsteam2{animation-delay:.5s}
.ov-h{animation:ov-h 10s ease-out infinite}.ov-h2{animation-delay:.6s}
