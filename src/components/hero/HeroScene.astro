@keyframes ov-tsteam{0%,72%{opacity:0;transform:translateY(8px)}77%{opacity:.9}88%,100%{opacity:0;transform:translateY(-30px)}}
@keyframes ov-h{0%,73%{opacity:0;transform:translateY(16px) scale(.5)}77%{opacity:1}88%,100%{opacity:0;transform:translateY(-44px) scale(1)}}
