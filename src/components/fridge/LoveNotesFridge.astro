---
// Love notes on Mary's fridge. Drop-in replacement for the current "Love notes" board.
// Usage: <LoveNotesFridge notes={[{ message: "…", name: "…" }]} />  (5 notes fill the grid best)
import logoPlate from "../../assets/brand/logo/on-cream/logo-horizontal.svg";
import maryHead from "../../assets/brand/mascot/mary-head.svg";
import thankYou from "../../assets/brand/stamps/sticker-thank-you.svg";
import magFudgyBrownie from "../../assets/brand/products/fudgy-brownie.svg";
import magRedVelvetCookie from "../../assets/brand/products/red-velvet-cookie.svg";
import magCupcake from "../../assets/brand/products/cupcake.svg";
import magSquareBentoCake from "../../assets/brand/products/square-bento-cake.svg";
import magBrownButterChocChip from "../../assets/brand/products/brown-butter-choc-chip.svg";

interface Note { message: string; name: string }
const { notes = Array.from({ length: 5 }, () => ({ message: "[REAL MESSAGE]", name: "[CUSTOMER NAME]" })) } = Astro.props as { notes?: Note[] };
const MAGNETS = [magFudgyBrownie, magRedVelvetCookie, magCupcake, magSquareBentoCake, magBrownButterChocChip];
const ROT = ['-2.5deg', '1.8deg', '-1.2deg', '2.4deg', '-1.8deg', '1.2deg'];
const MROT = ['-10deg', '8deg', '-6deg', '12deg', '-8deg'];
---
<div class="lnf">
  <div class="lnf-body">
    <div class="lnf-door lnf-freezer">
      <span class="lnf-handle" aria-hidden="true"></span>
      <div class="lnf-plate"><img src={logoPlate.src} alt="Mary And Kitchen" /></div>
      <div class="lnf-letters" aria-hidden="true"><span style="color:#A8263B;--r:-8deg;--i:0">Y</span><span style="color:#FFF5EA;--r:6deg;--i:1">U</span><span style="color:#B8CF9C;--r:-4deg;--i:2">M</span><span style="color:#D9A062;--r:10deg;--i:3">!</span></div>
      <div class="lnf-headmag" aria-hidden="true"><img src={maryHead.src} alt="" /></div>
    </div>
    <div class="lnf-door lnf-main">
      <span class="lnf-handle" aria-hidden="true"></span>
      <div class="lnf-grid">
    {notes.map((n, i) => (
      <figure class="lnf-note" style={`--r:${ROT[i % ROT.length]};--i:${i}`}>
        <img class="lnf-mag" src={MAGNETS[i % MAGNETS.length].src} alt="" style={`--mr:${MROT[i % MROT.length]}`} />
        <blockquote>{n.message}</blockquote>
        <figcaption>{n.name}</figcaption>
      </figure>
    ))}
    <div class="lnf-note lnf-list" style="--r:2deg;--i:5" aria-hidden="true"><svg class="lnf-heart" viewBox="4 0 48 44" aria-hidden="true"><path d="M28 14 C22 2 6 8 28 40 C50 8 34 2 28 14 Z" fill="#A8263B" stroke="#3F241E" stroke-width="3" stroke-linejoin="round"/></svg><h3>To bake</h3><ul><li><s>brownies</s> ✓</li><li><s>oat revel bars</s> ✓</li><li>more chocolate!!</li><li>read your notes ♥</li></ul></div>
      </div>
    </div>
  </div>
  <div class="lnf-feet" aria-hidden="true"><span></span><span></span></div>
  <img class="lnf-sticker" src={thankYou.src} alt="" aria-hidden="true" />
</div>
<script is:inline>(()=>{const el=document.currentScript.previousElementSibling;if(!el||!('IntersectionObserver' in window))return;
if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;el.classList.add('js');
const io=new IntersectionObserver(es=>{es.forEach(e=>{if(e.isIntersecting){el.classList.add('is-in');io.disconnect();}})},{threshold:.25});io.observe(el);})();</script>

<style>
.lnf{--pink:#EF7FA5;--rose:#D9577F;--blush:#FBD5E0;--cream:#FFF5EA;--cocoa:#3F241E;--red:#A8263B;--pist:#B8CF9C;--bisc:#D9A062;
  position:relative;max-width:980px;margin:0 auto;padding:0 16px 40px;font-family:'Nunito',system-ui,sans-serif;color:var(--cocoa)}
.lnf-body{position:relative;background:var(--rose);border:4px solid var(--cocoa);border-radius:64px 64px 44px 44px;padding:14px;display:flex;flex-direction:column;gap:12px;box-shadow:0 18px 0 -6px rgba(63,36,30,.12)}
.lnf-door{position:relative;background:var(--pink);border:4px solid var(--cocoa);border-radius:52px 52px 18px 18px;overflow:hidden}
.lnf-main{border-radius:18px 18px 34px 34px}
.lnf-door::before{content:"";position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(112deg,transparent 6%,rgba(255,245,234,.38) 6% 11%,transparent 11% 13.5%,rgba(255,245,234,.28) 13.5% 15%,transparent 15%)}
.lnf-door::after{content:"";position:absolute;inset:10px;border:3px solid rgba(217,87,127,.55);border-radius:inherit;pointer-events:none}
.lnf-handle{position:absolute;left:26px;width:20px;background:var(--cream);border:4px solid var(--cocoa);border-radius:12px;box-shadow:5px 0 0 rgba(63,36,30,.18);z-index:3}
.lnf-handle::before,.lnf-handle::after{content:"";position:absolute;left:50%;width:14px;height:10px;margin-left:-7px;background:var(--cocoa);border-radius:3px}
.lnf-handle::before{top:14px}.lnf-handle::after{bottom:14px}
.lnf-freezer{min-height:150px;display:flex;align-items:center;justify-content:center;gap:28px;padding:26px 40px 26px 80px;flex-wrap:wrap}
.lnf-freezer .lnf-handle{top:auto;bottom:22px;height:86px}
.lnf-plate{position:relative;z-index:2;background:var(--cream);border:4px solid var(--cocoa);border-radius:999px;padding:12px 30px;box-shadow:4px 5px 0 rgba(63,36,30,.18)}
.lnf-plate img{display:block;height:46px;width:auto}
.lnf-letters{position:relative;z-index:2;display:flex;gap:4px;align-items:flex-end}
.lnf-letters span{display:inline-block;font:900 48px/1 'Nunito',system-ui,sans-serif;-webkit-text-stroke:4px var(--cocoa);paint-order:stroke fill;
  text-shadow:4px 4px 0 rgba(63,36,30,.2);transform:rotate(var(--r));transition:transform .25s}
.lnf-letters span:hover{transform:rotate(0) translateY(-4px) scale(1.08)}
.lnf-headmag{position:relative;z-index:2;width:84px;height:84px;border-radius:50%;background:var(--blush);border:4px solid var(--cocoa);overflow:hidden;box-shadow:4px 5px 0 rgba(63,36,30,.18);transform:rotate(8deg)}
.lnf-headmag img{width:100%;height:100%;object-fit:contain;transform:translateY(6px) scale(1.1)}
.lnf-main{padding:44px 40px 56px 92px}
.lnf-main .lnf-handle{top:40px;height:180px}
.lnf-grid{position:relative;z-index:2;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:40px 30px;align-items:start}
.lnf-note{position:relative;margin:0;padding:38px 22px 20px;border:3px solid var(--cocoa);border-radius:16px;background:var(--blush);
  box-shadow:6px 7px 0 rgba(63,36,30,.18);transform:rotate(var(--r));transition:transform .3s cubic-bezier(.3,1.5,.5,1),box-shadow .3s}
.lnf-note:nth-child(even){background:var(--cream);margin-top:14px}
.lnf-note:hover{transform:rotate(0) translateY(-6px);box-shadow:8px 12px 0 rgba(63,36,30,.16)}
.lnf-note blockquote{margin:0;font-size:17px;font-weight:700;line-height:1.45}
.lnf-note figcaption{margin-top:12px;font:italic 600 17px/1.2 'Fraunces',Georgia,serif;font-variation-settings:"SOFT" 100;color:var(--rose)}
.lnf-mag{position:absolute;top:-30px;left:50%;width:62px;height:56px;object-fit:contain;margin-left:-31px;filter:drop-shadow(3px 4px 0 rgba(63,36,30,.25));transform:rotate(var(--mr));transition:transform .3s}
.lnf-note:hover .lnf-mag{transform:rotate(0) scale(1.1)}
.lnf-note.lnf-list{background:#FFFFFF;background-image:repeating-linear-gradient(transparent 0 27px,rgba(217,87,127,.35) 27px 29px);background-position:0 44px;
  border-left:3px solid var(--cocoa)}
.lnf-list::before{content:"";position:absolute;top:0;bottom:0;left:34px;width:2px;background:rgba(168,38,59,.45)}
.lnf-list h3{margin:0 0 6px;font:italic 700 22px/1.1 'Fraunces',Georgia,serif;font-variation-settings:"SOFT" 100;color:var(--red);padding-left:22px}
.lnf-list ul{list-style:none;margin:0;padding:0 0 0 22px;font-weight:800;font-size:16px;line-height:29px}
.lnf-list s{text-decoration-thickness:3px;text-decoration-color:var(--rose)}
.lnf-heart{position:absolute;top:-24px;left:50%;width:44px;margin-left:-22px;filter:drop-shadow(3px 4px 0 rgba(63,36,30,.25));transform:rotate(-8deg)}
.lnf-sticker{position:absolute;z-index:4;left:-26px;bottom:-30px;width:170px;transform:rotate(-10deg);filter:drop-shadow(3px 4px 0 rgba(63,36,30,.2))}
.lnf-feet{display:flex;justify-content:space-between;padding:0 70px}
.lnf-feet span{width:44px;height:16px;background:var(--cocoa);border-radius:0 0 10px 10px}
/* stick-on motion */
.lnf.js .lnf-note,.lnf.js .lnf-letters span,.lnf.js .lnf-sticker{opacity:0}
.lnf.is-in .lnf-note{animation:lnf-stick .7s cubic-bezier(.3,1.6,.5,1) both;animation-delay:calc(var(--i) * 120ms + 150ms)}
.lnf.is-in .lnf-note .lnf-mag,.lnf.is-in .lnf-note .lnf-heart{animation:lnf-clack .45s ease-out both;animation-delay:calc(var(--i) * 120ms + 600ms)}
.lnf.is-in .lnf-letters span{animation:lnf-drop .5s cubic-bezier(.3,1.6,.5,1) both;animation-delay:calc(var(--i) * 90ms)}
.lnf.is-in .lnf-sticker{animation:lnf-peel .6s ease-out both;animation-delay:1s}
@keyframes lnf-stick{0%{opacity:0;transform:translateY(-40px) rotate(calc(var(--r) + 8deg)) scale(1.06)}60%{opacity:1}100%{opacity:1;transform:rotate(var(--r))}}
@keyframes lnf-clack{0%{transform:rotate(var(--mr,-8deg)) scale(1)}40%{transform:rotate(var(--mr,-8deg)) scale(1.25)}100%{transform:rotate(var(--mr,-8deg)) scale(1)}}
@keyframes lnf-drop{0%{opacity:0;transform:translateY(-30px) rotate(var(--r))}100%{opacity:1;transform:rotate(var(--r))}}
@keyframes lnf-peel{0%{opacity:0;transform:rotate(-30deg) scale(.6)}100%{opacity:1;transform:rotate(-10deg)}}
@media (max-width:820px){.lnf-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:600px){
  .lnf-body{border-radius:44px 44px 30px 30px;padding:10px}
  .lnf-freezer{padding:22px 18px 22px 52px;gap:16px}.lnf-plate img{height:34px}.lnf-letters span{font-size:38px}.lnf-headmag{display:none}
  .lnf-main{padding:44px 18px 64px 52px}.lnf-handle{left:14px;width:16px}
  .lnf-grid{grid-template-columns:1fr;gap:44px}.lnf-note:nth-child(even){margin-top:0}
  .lnf-sticker{width:130px;left:-14px}.lnf-feet{padding:0 40px}}
@media (prefers-reduced-motion:reduce){.lnf.js .lnf-note,.lnf.js .lnf-letters span,.lnf.js .lnf-sticker{opacity:1;animation:none!important}
  .lnf-note,.lnf-mag,.lnf-letters span{transition:none}}
</style>
