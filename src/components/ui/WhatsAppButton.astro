---
import { whatsappLink } from '../../data/site';

interface Props {
  label: string;
  message?: string;
  variant?: 'pink' | 'paper';
  class?: string;
}
const { label, message, variant = 'pink', class: className } = Astro.props;
---

<a
  class:list={['btn', variant === 'pink' && 'btn--pink', className]}
  href={whatsappLink(message)}
  target="_blank"
  rel="noopener"
  data-whatsapp
>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M4.6 19.4 5.7 16A8 8 0 1 1 8.4 18.6Z M9 9.2c0 3 2.6 5.8 5.8 5.8l1-1.4-1.9-.9-.9.9c-1-.4-2-1.4-2.4-2.4l.9-.9-.9-1.9Z"
    ></path>
  </svg>
  <span>{label}</span>
</a>
